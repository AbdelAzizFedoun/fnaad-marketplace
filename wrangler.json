{
  "name": "fnaad-marketplace",
  "compatibility_date": "2024-09-23",
  "main": "worker.js",
  "routes": [
    {
      "pattern": "fnaad-marketplace.com",
      "custom_domain": true
    },
    {
      "pattern": "www.fnaad-marketplace.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
