# --- Database ---------------------------------------------------------------
# Leave DB_ENGINE unset (or sqlite) for local development.
# Set DB_ENGINE=django.db.backends.postgresql to use PostgreSQL.
#
#DB_ENGINE=django.db.backends.postgresql
#DB_NAME=fnaad
#DB_USER=fnaad
#DB_PASSWORD=change-me
#DB_HOST=localhost
#DB_PORT=5432
#DB_CONN_MAX_AGE=60

# --- Email (password reset codes) -------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- AI providers (Sanaa) ---------------------------------------------------
# Empty = Sanaa answers from the offline set and logs a warning.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SANAA_GEMINI_MODEL=gemini-3.8-flash
SANAA_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Fapshi (Mobile Money) --------------------------------------------------
# NEVER commit real values — production secrets belong in the server env only.
FAPSHI_BASE_URL=https://sandbox.fapshi.com
FAPSHI_APIUSER=
FAPSHI_APIKEY=

SUBSCRIPTION_PRICE_1_MONTH=2000
SUBSCRIPTION_PRICE_2_MONTHS=4000
SUBSCRIPTION_PRICE_3_MONTHS=6500

# --- Deployment -------------------------------------------------------------
#SITE_BASE_URL=https://your-domain.com
#DEBUG=false
#SECRET_KEY=generate-with-python--c-"import secrets; print(secrets.token_urlsafe(50))"
