# Expo app environment (baked in at build time)
# Copy to .env and fill in the production API URL before `npx expo export` or EAS builds.

# Must end with /api
EXPO_PUBLIC_API_BASE_URL=https://api.your-domain.com/api
# Origin without the /api suffix — used for media URLs
EXPO_PUBLIC_API_ORIGIN=https://api.your-domain.com

# Mobile Money details shown during subscription checkout
EXPO_PUBLIC_FNAAD_SUBSCRIPTION_MOMO_PROVIDER=Orange Money
EXPO_PUBLIC_FNAAD_SUBSCRIPTION_MOMO_NUMBER=
EXPO_PUBLIC_FNAAD_SUBSCRIPTION_WHATSAPP=237688254466
