{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://fnaad-marketplace-api.onrender.com/api",
        "EXPO_PUBLIC_API_ORIGIN": "https://fnaad-marketplace-api.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://fnaad-marketplace-api.onrender.com/api",
        "EXPO_PUBLIC_API_ORIGIN": "https://fnaad-marketplace-api.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}