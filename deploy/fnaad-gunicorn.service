[Unit]
Description=FNAAD marketplace Django API (gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
# Create a dedicated user: sudo adduser --system --group fnaad
User=fnaad
Group=fnaad
WorkingDirectory=/opt/fnaad/fnaad-backend
# Production secrets live here — keep it chmod 600, owned by root:fnaad
EnvironmentFile=/opt/fnaad/fnaad-backend/.env
ExecStart=/opt/fnaad/fnaad-backend/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120 --access-logfile - --error-logfile -
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
